{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manvalan/uses-rules/schema/principles.schema.json",
  "title": "USES design principles",
  "type": "object",
  "required": [
    "set",
    "version",
    "principles"
  ],
  "additionalProperties": false,
  "properties": {
    "set": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "string"
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/principle"
      }
    }
  },
  "$defs": {
    "principle": {
      "type": "object",
      "required": [
        "id",
        "name",
        "title",
        "summary",
        "check"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DP-\\d{3}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "apply": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "check": {
          "type": "string"
        },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "avoid": {
              "type": "string"
            },
            "prefer": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
